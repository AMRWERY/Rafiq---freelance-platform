{
  // Editor IntelliSense for this layer piggybacks on the admin app's generated types.
  // Run `pnpm --filter admin postinstall` (nuxt prepare) at least once after install.
  "extends": "../../apps/admin/.nuxt/tsconfig.json",
  "compilerOptions": {
    // Point ~ / @ back at this layer's own root. Without this, `~/types/...` imports
    // (e.g. inside defineProps<T>()) resolve against apps/admin instead of packages/ui,
    // since Vue's compiler resolves type-only imports via TypeScript's own path mapping
    // (the nearest tsconfig.json), not Nuxt's runtime per-layer alias plugin.
    "baseUrl": ".",
    "paths": {
      "~": ["."],
      "~/*": ["./*"],
      "@": ["."],
      "@/*": ["./*"]
    }
  }
}
